<Window x:Class="BatomonTracker.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Left="20"
        Top="20"
        Width="470"
        Height="500"
        Opacity="0.96">
    <Border Background="#F2233D4D"
            BorderBrush="#668A9BB8"
            BorderThickness="1"
            CornerRadius="18"
            Padding="22"
            MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="LIVE TRACKER"
                               Foreground="#A1C181"
                               FontSize="11"
                               FontWeight="Bold" />
                    <TextBlock Text="BUILD CORRENTE"
                               Margin="0,3,0,0"
                               Foreground="#9DB7D2"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="9,5"
                        Background="#2D4B5D"
                        CornerRadius="8">
                    <TextBlock Text="LIVE"
                               Foreground="#A1C181"
                               FontSize="10"
                               FontWeight="Bold"/>
                </Border>
            </Grid>
            <TextBlock x:Name="TrainerText"
                       Margin="0,13,0,0"
                       Foreground="White"
                       FontSize="25"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="RoundText"
                       Margin="0,3,0,16"
                       Foreground="#C7D3E0"
                       FontSize="15" />
            <Border Background="#332D4B5D"
                    BorderBrush="#446477"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12">
                <StackPanel>
                    <TextBlock Text="TEAM"
                               Foreground="#9DB7D2"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <ScrollViewer MaxHeight="93"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto"
                            Margin="0,6,0,0">
                        <WrapPanel x:Name="TeamPanel" />
                    </ScrollViewer>
                    <TextBlock x:Name="TrinketText"
                               Margin="0,9,0,0"
                               Foreground="#D7B979"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="0,12,0,0"
                    Padding="14"
                    Background="#24394A"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="PROSSIMA MOSSA"
                               Foreground="#9DB7D2"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="RecommendationText"
                               Margin="0,5,0,0"
                               Foreground="#9ED6A5"
                               FontSize="15"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="BATOMON CONSIGLIATI"
                               Foreground="#9DB7D2"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="RecommendedBatomonText"
                               Margin="0,4,0,0"
                               Foreground="#9ED6A5"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Text="Analisi in attesa..." />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="STRUMENTI CONSIGLIATI"
                               Foreground="#9DB7D2"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="RecommendedToolsText"
                               Margin="0,4,0,0"
                               Foreground="#D7B979"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Text="Analisi in attesa..." />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="HintText"
                       Margin="0,15,0,0"
                       Foreground="#8192A6"
                       FontSize="11"
                       Text="Ctrl+Shift+O mostra/nasconde · Ctrl+Shift+L sblocca" />
        </StackPanel>
    </Border>
</Window>
