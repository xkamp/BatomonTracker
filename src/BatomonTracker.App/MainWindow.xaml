<Window x:Class="BatomonTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batomon Tracker"
        Height="780"
        Width="1280"
        MinHeight="680"
        MinWidth="980"
        Background="#233d4d"
        Foreground="#F7F4EA"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D4B5D"/>
            <Setter Property="Foreground" Value="#F7F4EA"/>
            <Setter Property="BorderBrush" Value="#446477"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#FE7F2D"/>
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FE7F2D"/>
            <Setter Property="Foreground" Value="#233d4d"/>
            <Setter Property="BorderBrush" Value="#FE7F2D"/>
        </Style>

        <Style x:Key="NavigationButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C9D8D1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavMark" Background="Transparent" CornerRadius="2" Margin="0,2,12,2"/>
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="#2D4B5D"/>
                                <Setter TargetName="NavMark" Property="Background" Value="#FE7F2D"/>
                                <Setter Property="Foreground" Value="#F7F4EA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavChrome" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.985" ScaleY="0.985"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FBFAF7"/>
            <Setter Property="BorderBrush" Value="#D6DED5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#233D4D"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="#FE7F2D"/>
                                <Setter TargetName="InputChrome" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FBFAF7"/>
            <Setter Property="BorderBrush" Value="#D6DED5"/>
            <Setter Property="Foreground" Value="#233D4D"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#233d4d"/>
            <Setter Property="BorderBrush" Value="#E3E8E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="#A1C181"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#EEF3EA"/>
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="#A1C181"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigazione -->
        <Grid Grid.Column="0" Background="#233d4d" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="26,28,24,30">
                <TextBlock Text="BATOMON"
                            FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FE7F2D"/>
                <TextBlock Text="SHOWDOWN TRACKER"
                           Margin="1,3,0,0"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#A1C181"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="14,0,14,0">
                <TextBlock Text="ESPLORA"
                           Margin="12,0,0,12"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#A1C181"/>

                <Button Tag="Home" Click="Navigation_Click"
                        Style="{StaticResource NavigationButton}">Home</Button>
                <Button Tag="Live Overlay" Click="Navigation_Click"
                        Style="{StaticResource NavigationButton}">Live overlay</Button>
                <Button Tag="Le mie run" Click="Navigation_Click"
                        Style="{StaticResource NavigationButton}">Le mie run</Button>
                <Button Tag="Le mie build" Click="Navigation_Click"
                        Style="{StaticResource NavigationButton}">Le mie build</Button>
                <Button Tag="Leaderboard" Click="Navigation_Click"
                        Style="{StaticResource NavigationButton}">Leaderboard</Button>
                <Button Tag="Analytics" Click="Navigation_Click"
                        Style="{StaticResource NavigationButton}">Analytics</Button>
                <Button Tag="Patch notes" Click="Navigation_Click"
                        Style="{StaticResource NavigationButton}">Patch notes</Button>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="14,0,14,24">
                <Border Height="1" Background="#446477" Margin="8,0,8,14"/>

                <Button Tag="Impostazioni" Click="Navigation_Click"
                        Style="{StaticResource NavigationButton}">Impostazioni</Button>

                <Border Margin="8,12,8,0"
                        Padding="12,9"
                        Background="#2D4B5D"
                        CornerRadius="8">
                    <TextBlock x:Name="ConnectionText"
                               Text="LOCAL MODE"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#A1C181"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Contenuto -->
            <Grid Grid.Column="1" Background="#F3F1EB">

            <Grid x:Name="DashboardPanel"
                  Margin="36,30,36,28"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Intestazione -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle"
                                   Text="Home"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#233d4d"/>
                        <TextBlock x:Name="PageSubtitle"
                                   Text="Il tuo centro di controllo per Batomon Showdown"
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="#619b8a"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Click="RefreshHistory_Click"
                                Background="#FCCA46"
                                Foreground="#233d4d"
                                BorderBrush="#FCCA46"
                                Padding="16,10">Aggiorna dati</Button>

                        <Button x:Name="ProfileButton"
                                Width="42"
                                Height="42"
                                Margin="12,4,0,4"
                                Padding="0"
                                Background="#233d4d"
                                BorderBrush="#233d4d"
                         Click="ProfileButton_Click"
                         ToolTip="Profilo">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ProfileMenu">
                                    <MenuItem x:Name="ProfileLoginMenuItem"
                                              Header="Accedi con Steam"
                                              Click="ProfileLogin_Click"/>
                                    <MenuItem x:Name="ProfileLogoutMenuItem"
                                              Header="Logout"
                                              Click="ProfileLogout_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Border Width="28"
                                    Height="28"
                                    Background="#A1C181"
                                    CornerRadius="14">
                                <Path Fill="#233d4d"
                                      Stretch="Uniform"
                                      Margin="7"
                                      Data="M12,12 A4,4 0 1 0 12,4 A4,4 0 0 0 12,12 M4,21 C4,17 7.6,14 12,14 C16.4,14 20,17 20,21 Z"/>
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Stato live -->
                <Border Grid.Row="1"
                        Margin="0,28,0,28"
                        Padding="22"
                        Background="#E8E3D6"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#FE7F2D"
                                CornerRadius="2"/>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Text="STATO LIVE"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#619b8a"/>

                            <TextBlock x:Name="StatusText"
                                       Text="Ricerca dei file del gioco..."
                                       Margin="0,7,0,0"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="#233d4d"/>

                            <TextBlock x:Name="LiveText"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#233d4d"/>

                            <TextBlock x:Name="TrinketText"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#619b8a"/>

                            <TextBlock x:Name="ProfileText"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#233d4d"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,8,16" Padding="18" Background="#FFFFFF" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="TOP 3 PIU GIOCATI" FontSize="11" FontWeight="Bold" Foreground="#619b8a"/>
                                    <TextBlock Text="Presenza nelle tue run" Margin="0,4,0,14" Foreground="#536873"/>
                                    <StackPanel x:Name="TopPlayedPodium" Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="8,0,0,16" Padding="18" Background="#FFFFFF" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="TOP 3 PER VITTORIE" FontSize="11" FontWeight="Bold" Foreground="#619b8a"/>
                                    <TextBlock Text="Le presenze che hanno chiuso meglio" Margin="0,4,0,14" Foreground="#536873"/>
                                    <StackPanel x:Name="TopWinsPodium" Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,8,16" Padding="18" Background="#E8E3D6" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="MIGLIOR COMBO" FontSize="11" FontWeight="Bold" Foreground="#619b8a"/>
                                    <TextBlock Text="La coppia piu presente nelle run vinte" Margin="0,4,0,14" Foreground="#536873"/>
                                    <TextBlock x:Name="BestComboText" Text="Dati insufficienti" FontSize="22" FontWeight="Bold" Foreground="#233d4d"/>
                                    <TextBlock x:Name="BestComboDetailText" Margin="0,8,0,0" Foreground="#536873" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="8,0,0,16" Padding="18" Background="#233d4d" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="PATCH IN ARRIVO" FontSize="11" FontWeight="Bold" Foreground="#A1C181"/>
                                    <TextBlock Text="Nuovi dati, nuove letture del meta." Margin="0,8,0,0" FontSize="19" FontWeight="Bold" Foreground="#F7F4EA" TextWrapping="Wrap"/>
                                    <Button x:Name="PatchNotesTeaserButton" Margin="0,18,0,0" HorizontalAlignment="Left" Background="#FE7F2D" Foreground="#233d4d" BorderBrush="#FE7F2D" Click="PatchNotesTeaser_Click">LEGGI PATCH NOTES</Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Padding="18" Background="#FFFFFF" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="MIGLIOR SQUADRA A 10 VITTORIE" FontSize="11" FontWeight="Bold" Foreground="#619b8a"/>
                                <TextBlock x:Name="BestTeamText" Text="Nessuna squadra ha ancora raggiunto 10 vittorie." Margin="0,8,0,0" FontSize="18" FontWeight="Bold" Foreground="#233d4d" TextWrapping="Wrap"/>
                                <TextBlock x:Name="BestTeamDetailText" Margin="0,6,0,0" Foreground="#536873" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Run recenti" Margin="0,24,0,10" FontSize="20" FontWeight="Bold" Foreground="#233d4d"/>
                        <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="RunsPanel" Margin="36,30,36,28" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Le mie run" FontSize="30" FontWeight="Bold" Foreground="#233d4d"/>
                    <TextBlock Text="Tutta la tua storia, composizione dopo composizione." Margin="0,5,0,0" FontSize="13" Foreground="#619b8a"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,26,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="HistoryCardsPanel">
                        <TextBlock Text="Caricamento storico..." Foreground="#619b8a"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="BuildsPanel" Margin="36,30,36,28" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Le mie build" FontSize="30" FontWeight="Bold" Foreground="#233d4d"/>
                        <TextBlock Text="Le composizioni che hanno funzionato e quelle che vuoi provare." Margin="0,5,0,0" FontSize="13" Foreground="#619b8a"/>
                        <TextBlock Text="TOP 3 BUILD PERSONALI" Margin="0,28,0,12" FontSize="11" FontWeight="Bold" Foreground="#619b8a"/>
                        <StackPanel x:Name="BestBuildsPanel"/>
                        <Border Margin="0,22,0,0" Padding="22" Background="#FFFFFF" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="CREA LA TUA BUILD" FontSize="11" FontWeight="Bold" Foreground="#FE7F2D"/>
                                <TextBlock Text="Salva una composizione da tenere a portata di mano durante le partite." Margin="0,7,0,18" Foreground="#536873" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="BuildNameTextBox" Grid.Column="0" Margin="0,0,10,0" Padding="10,8" Foreground="#233d4d" ToolTip="Nome build"/>
                                    <TextBox x:Name="BuildSpeciesTextBox" Grid.Column="1" Margin="0,0,10,0" Padding="10,8" Foreground="#233d4d" ToolTip="boomagon, shellter, ..."/>
                                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Click="SaveCustomBuild_Click">SALVA BUILD</Button>
                                </Grid>
                                <TextBlock Text="Inserisci gli species_id separati da virgole." Margin="0,9,0,0" FontSize="12" Foreground="#619b8a"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="BUILD SALVATE" Margin="0,26,0,12" FontSize="11" FontWeight="Bold" Foreground="#619b8a"/>
                        <StackPanel x:Name="CustomBuildsPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="AnalyticsPanel"
                  Margin="36,30,36,28"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Analytics"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#233d4d"/>
                    <TextBlock Text="Esplora le composizioni osservate nella cache locale"
                               Margin="0,5,0,0"
                               FontSize="13"
                               Foreground="#619b8a"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,26,0,22"
                        Padding="18"
                        Background="#E8E3D6"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="BATOMON ID" FontSize="10" FontWeight="Bold" Foreground="#619b8a"/>
                            <TextBox x:Name="AnalyticsSpeciesTextBox"
                                     Margin="0,6,0,0"
                                     Padding="10,8"
                                     BorderBrush="#C6D0C5"
                                     Text="boomagon"
                                     Foreground="#233d4d"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="FASE" FontSize="10" FontWeight="Bold" Foreground="#619b8a"/>
                            <ComboBox x:Name="AnalyticsPhaseComboBox"
                                      Margin="0,6,0,0"
                                      Padding="8"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Tutte" Tag="all"/>
                                <ComboBoxItem Content="Standard" Tag="standard"/>
                                <ComboBoxItem Content="Extended" Tag="extended"/>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Margin="0,17,0,0"
                                Style="{StaticResource AccentButton}"
                                Click="AnalyticsSearch_Click">ANALIZZA</Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Padding="20" Background="#FFFFFF" CornerRadius="12" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Statistiche Batomon" FontSize="20" FontWeight="Bold" Foreground="#233d4d"/>
                            <TextBlock x:Name="AnalyticsSummaryText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#536873"/>
                            <TextBlock x:Name="AnalyticsStatusText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#619b8a"/>
                            <TextBlock Text="Winrate per turno" Margin="0,24,0,0" FontSize="15" FontWeight="Bold" Foreground="#233d4d"/>
                            <ListBox x:Name="AnalyticsRoundList"
                                     Margin="0,10,0,0"
                                     Height="170"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="20" Background="#FFFFFF" CornerRadius="12" Margin="12,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Più giocati insieme" FontSize="20" FontWeight="Bold" Foreground="#233d4d"/>
                            <ListBox x:Name="AnalyticsCompanionList"
                                     Grid.Row="1"
                                     Margin="0,14,0,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsPanel" Margin="36,30,36,28" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Impostazioni" FontSize="30" FontWeight="Bold" Foreground="#233d4d"/>
                    <TextBlock Text="Personalizza il comportamento dell'overlay live" Margin="0,5,0,0" FontSize="13" Foreground="#619b8a"/>
                    <Border Margin="0,28,0,0" Padding="22" Background="#FFFFFF" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="OVERLAY LIVE" FontSize="11" FontWeight="Bold" Foreground="#619b8a"/>
                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Scala" FontSize="15" FontWeight="SemiBold" Foreground="#233d4d"/>
                                    <Slider x:Name="OverlayScaleSlider" Margin="0,10,20,0" Minimum="0.75" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="OverlayScaleSlider_ValueChanged"/>
                                </StackPanel>
                                <TextBlock x:Name="OverlayScaleValueText" Grid.Column="1" VerticalAlignment="Bottom" TextAlignment="Right" FontSize="15" Foreground="#619b8a"/>
                            </Grid>
                            <Grid Margin="0,24,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Opacita" FontSize="15" FontWeight="SemiBold" Foreground="#233d4d"/>
                                    <Slider x:Name="OverlayOpacitySlider" Margin="0,10,20,0" Minimum="0.35" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OverlayOpacitySlider_ValueChanged"/>
                                </StackPanel>
                                <TextBlock x:Name="OverlayOpacityValueText" Grid.Column="1" VerticalAlignment="Bottom" TextAlignment="Right" FontSize="15" Foreground="#619b8a"/>
                            </Grid>
                            <CheckBox x:Name="OverlayStartVisibleCheckBox" Margin="0,26,0,0" Content="Mostra automaticamente l'overlay quando il gioco e visibile" Foreground="#233d4d" Checked="OverlayStartVisibleCheckBox_Changed" Unchecked="OverlayStartVisibleCheckBox_Changed"/>
                            <TextBlock Text="Le modifiche vengono salvate automaticamente. Usa Ctrl+Shift+O per mostrare o nascondere l'overlay." Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#619b8a"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PatchNotesPanel" Margin="36,30,36,28" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Patch notes" FontSize="30" FontWeight="Bold" Foreground="#233d4d"/>
                    <TextBlock Text="Le prossime modifiche al tracker e al meta." Margin="0,5,0,0" FontSize="13" Foreground="#619b8a"/>
                    <Border Margin="0,28,0,0" Padding="24" Background="#FFFFFF" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="PATCH 0.4 · IN ARRIVO" FontSize="11" FontWeight="Bold" Foreground="#FE7F2D"/>
                            <TextBlock Text="Una Home piu leggibile e statistiche che raccontano le tue run." Margin="0,12,0,0" FontSize="22" FontWeight="Bold" Foreground="#233d4d" TextWrapping="Wrap"/>
                            <TextBlock Text="Podio dei Batomon piu giocati, migliori vittorie, combo ricorrenti e la prima squadra arrivata a 10 vittorie. Questa nota e provvisoria: i dettagli verranno aggiornati con la prossima versione." Margin="0,12,0,0" FontSize="14" LineHeight="22" Foreground="#536873" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="LiveOverlayPanel" Margin="36,30,36,28" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Live overlay" FontSize="30" FontWeight="Bold" Foreground="#233d4d"/>
                    <TextBlock Text="La build corrente e il percorso piu vicino alle composizioni vincenti globali." Margin="0,5,0,0" FontSize="13" Foreground="#619b8a"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,28,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Padding="20" Background="#E8E3D6" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="BUILD CORRENTE" FontSize="11" FontWeight="Bold" Foreground="#619b8a"/>
                                <TextBlock x:Name="LiveOverlayStatusText" Text="In attesa del save live..." Margin="0,8,0,0" FontSize="19" FontWeight="SemiBold" Foreground="#233d4d"/>
                                <WrapPanel x:Name="LiveOverlayTeamPanel" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,8,0" Padding="20" Background="#FFFFFF" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="BATOMON CONSIGLIATI" FontSize="11" FontWeight="Bold" Foreground="#619b8a"/>
                                    <WrapPanel x:Name="LiveOverlayRecommendedPanel" Margin="0,14,0,0"/>
                                    <TextBlock x:Name="LiveOverlayReferenceText" Margin="0,14,0,0" Foreground="#536873" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="8,0,0,0" Padding="20" Background="#233d4d" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="STRUMENTI CONSIGLIATI" FontSize="11" FontWeight="Bold" Foreground="#A1C181"/>
                                    <TextBlock x:Name="LiveOverlayToolsText" Margin="0,14,0,0" Text="In attesa dell'analisi globale..." Foreground="#F7F4EA" FontSize="16" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Accesso -->
            <Grid x:Name="LoginPanel" Background="#F7F4EA">
                <Border Width="440"
                        Padding="38"
                        Background="#FFFFFF"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <Border Width="52"
                                Height="5"
                                Background="#FE7F2D"
                                CornerRadius="3"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,26"/>

                        <TextBlock Text="BENVENUTO"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#619b8a"/>

                        <TextBlock Text="Il tuo compagno di gioco"
                                   Margin="0,10,0,0"
                                   FontSize="29"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="#233d4d"/>

                        <TextBlock Text="Accedi per sincronizzare i tuoi dati, seguire le classifiche e ricevere le patch notes."
                                   Margin="0,14,0,28"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Foreground="#536873"/>

                        <Button Style="{StaticResource AccentButton}"
                                Padding="16,13"
                                Click="SteamLogin_Click">ACCEDI CON STEAM</Button>

                        <Button Padding="16,13"
                                Click="OfflineLogin_Click">CONTINUA OFFLINE</Button>

                        <TextBlock x:Name="LoginStatusText"
                                   Margin="0,18,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#619b8a"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
